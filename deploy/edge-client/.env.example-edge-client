# ============================================================
# EDGE-CLIENT CONFIGURATION
#
# All machine configuration (machine ID, location, devices, Modbus
# connections, poll interval) lives in the JSON mapping (MQTT_MAPPING_PATH).
# This file only holds external connection credentials.
# ============================================================

# ============================================================
# MQTT BROKER
# ============================================================
MQTT_HOST=your-mqtt-broker-host
MQTT_PORT=443
MQTT_USERNAME=yourusername
MQTT_PASSWORD=yourpassword
MQTT_CLIENT_ID=acme-edge-area2-machine_c
MQTT_PROTOCOL=wss
MQTT_TLS_SSL=true
MQTT_WEBSOCKET_PATH=/mqtt
MQTT_KEEPALIVE=60
MQTT_PUBLISH_QOS=1

# ============================================================
# MAPPING FILE
# Path to the JSON that defines all devices and parameters.
# Format (example-mapping.json): a "devices" array with a
# per-device Modbus connection.
# ============================================================
MQTT_MAPPING_PATH=./mapping.json

# ============================================================
# CACHE (Valkey / Redis) — for the control gate
# Empty = all control is denied (safe by default).
# Format: redis://[user:pass@]host:port[/db]
# ============================================================
CACHE_URL=

# ============================================================
# CONTROL GATE
# The hash key in Valkey that the operator sets to allow control.
# Grant: redis-cli HSET control global 1
#        redis-cli HSET control acme/site/area2/machine_c 1
# ============================================================
CONTROL_GATE_KEY=control

# ============================================================
# LOGGING
# ============================================================
RUST_LOG=info
