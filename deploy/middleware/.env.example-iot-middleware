# ============================================================
# IOT-MIDDLEWARE CONFIGURATION
#
# The machine list and every topic come from the JSON mapping
# (MQTT_MAPPING_PATH). This file holds connection settings and
# runtime tuning.
# ============================================================

# ============================================================
# MQTT BROKER
# ============================================================
MQTT_HOST=your-mqtt-broker-host
MQTT_PORT=1883
MQTT_USERNAME=yourusername
MQTT_PASSWORD=yourpassword
MQTT_CLIENT_ID=acme-iot-middleware
MQTT_PROTOCOL=mqtt
MQTT_TLS_SSL=false
# MQTT_WEBSOCKET_PATH=/mqtt
MQTT_KEEPALIVE=60
MQTT_PUBLISH_QOS=1

# ============================================================
# MAPPING FILE
# A single file, or a directory with _base.json and one *.json
# file per machine (see mqtt-mapping/).
# ============================================================
MQTT_MAPPING_PATH=./mqtt-mapping

# ============================================================
# SCYLLADB
# Schema: init.cql
# ============================================================
SCYLLA_NODES=127.0.0.1:9042
SCYLLA_KEYSPACE=iot_middleware
SCYLLA_CONSISTENCY=LocalOne
SCYLLA_USERNAME=yourusername
SCYLLA_PASSWORD=yourpassword
SCYLLA_TELEMETRY_CHANNEL=10000
SCYLLA_TELEMETRY_BATCH=100
SCYLLA_TELEMETRY_FLUSH_MS=200
SCYLLA_TELEMETRY_CONCURRENCY=32

# ============================================================
# CACHE (Valkey / Redis)
# Empty = cache disabled.
# Format: redis://[user:pass@]host:port[/db]
# ============================================================
CACHE_URL=
CACHE_KEY_PREFIX=iot:middleware
CACHE_TELEMETRY_TTL_SECS=3600
CACHE_STATE_TTL_SECS=86400

# ============================================================
# LOGGING
# ============================================================
RUST_LOG=info
